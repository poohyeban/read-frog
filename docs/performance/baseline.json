  "platform": "Linux-6.18.55-x86_64-with-glibc2.41",
  "manifest": {
    "manifest_version": 3,
    "name": "Read Frog Lite",
    "description": "Independent page, selection and subtitle translation with your own services.",
    "version": "0.2.5",
    "icons": {
      "16": "icon/16.png",
      "32": "icon/32.png",
      "48": "icon/48.png",
      "96": "icon/96.png",
      "128": "icon/128.png"
    },
    "default_locale": "en",
    "permissions": [
      "offscreen",
      "storage",
      "tabs",
      "alarms",
      "contextMenus",
      "scripting",
      "webNavigation"
    ],
    "host_permissions": ["*://*/*"],
    "web_accessible_resources": [
      {
        "resources": ["assets/*.png", "assets/*.svg", "assets/*.webp"],
        "matches": ["*://*/*", "file:///*"]
      }
    ],
    "background": {
      "type": "module",
      "service_worker": "background.js"
    },
    "action": {
      "default_title": "Popup | Read Frog Lite",
      "default_popup": "popup.html"
    },
    "options_ui": {
      "open_in_tab": true,
      "page": "options.html"
    },
    "content_scripts": [
      {
        "matches": ["*://*/*"],
        "all_frames": true,
        "match_about_blank": true,
        "js": ["content-scripts/iframe-selection-trigger.js"],
        "match_origin_as_fallback": true
      },
      {
        "matches": ["*://*/*"],
        "run_at": "document_start",
        "js": ["content-scripts/input-injector.js"],
        "world": "MAIN"
      },
      {
        "matches": ["*://*.youtube-nocookie.com/*", "*://*.youtube.com/*"],
        "all_frames": true,
        "run_at": "document_start",
        "js": ["content-scripts/interceptor.js"],
        "world": "MAIN"
      },
      {
        "matches": ["*://*/*", "file:///*"],
        "js": ["content-scripts/loader.js"]
      },
      {
        "matches": ["*://www.netflix.com/*"],
        "run_at": "document_start",
        "js": ["content-scripts/netflix-interceptor.js"],
        "world": "MAIN"
      },
      {
        "matches": [
          "*://*.twitter.com/*",
          "*://*.x.com/*",
          "*://*.youtube-nocookie.com/*",
          "*://*.youtube.com/*",
          "*://twitter.com/*",
          "*://www.netflix.com/*",
          "*://x.com/*"
        ],
        "all_frames": true,
        "js": ["content-scripts/subtitles.js"]
      }
    ]
  },
