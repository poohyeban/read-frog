    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "oxlint --type-aware --type-check",
    "zip": "wxt zip",
    "zip:edge": "wxt zip -b edge",
    "prepare": "husky",
    "test:e2e": "playwright test",
    "perf:report": "vitest run --config vitest.perf.config.ts"
  },
