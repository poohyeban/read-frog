{
  "name": "read-frog-lite",
  "version": "0.2.5",
  "private": true,
  "description": "Independent Chromium translation, native subtitles and user-configured audio services",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "build:edge": "wxt build -b edge",
    "build:analyze": "wxt build --analyze",
    "dev": "wxt",
    "dev:edge": "wxt -b edge",
    "fmt": "oxfmt --write .",
